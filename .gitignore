*.xplt

# FEBio and meshing artifacts, wherever a run or script drops them.
# Runs belong in simulation/outputs/ (ignored above); these catch strays.
# Solver input decks: generated by run.py; a hand-written test fixture may live under tests/
*.feb
!tests/**/*.feb
# FEBio main log, captured stdout, and node_data logs (names from backends/febio)
*.log
febio_stdout.txt
tip.txt
clamp.txt
nodes_u.txt
# Mesh and result arrays
*.npz
*.vtu
*.msh
estimates.csv

# Parametric PneuNet designs, rebuilt with
#   python -m simulation.models.tools.make_pneunet --standard-variants
# finger_poc/ (source CAD) and tools/ stay tracked
simulation/models/pn_*/
